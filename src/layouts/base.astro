---
import '../styles/global.css'

import { shop } from '../lib/shop'

const title = 'PC Tune-Ups | Computer and Device Repair in Metairie'

const description =
	'Walk-in computer, laptop, phone, and tablet repair at 3943 Veterans Blvd in Metairie. Open Monday to Saturday, 10AM to 6PM.'

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ComputerStore',
	name: shop.name,
	telephone: shop.phone,
	email: shop.email,
	hasMap: shop.mapUrl,
	address: {
		'@type': 'PostalAddress',
		streetAddress: shop.street,
		addressLocality: shop.city,
		addressRegion: shop.region,
		addressCountry: 'US',
	},
	openingHoursSpecification: {
		'@type': 'OpeningHoursSpecification',
		dayOfWeek: [
			'Monday',
			'Tuesday',
			'Wednesday',
			'Thursday',
			'Friday',
			'Saturday',
		],
		opens: '10:00',
		closes: '18:00',
	},
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="pc repair, iphone repair, tablet repair, laptop repair, metairie, new orleans, kenner, LA"
		/>
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<link rel="icon" type="image/png" href="/icon.png" />
		<link rel="preload" as="image" href="/photos/pc1.webp" />
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
