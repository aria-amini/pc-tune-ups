---
import { type IconNode, icons } from 'lucide'

interface Props {
	name?: keyof typeof icons
	node?: IconNode
	class?: string
}

const { name, node, class: className } = Astro.props
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width="24"
	height="24"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	{(node ?? (name ? icons[name] : [])).map(([Tag, attributes]) => (
		<Tag {...attributes} />
	))}
</svg>
