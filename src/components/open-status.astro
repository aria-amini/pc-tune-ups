---
interface Props {
	class?: string
}

const { class: className } = Astro.props
---

<p
	data-open-status
	data-state="unknown"
	class:list={[
		'inline-flex items-center gap-3 text-base font-semibold',
		className,
	]}
>
	<span
		aria-hidden="true"
		class="size-2.5 shrink-0 rounded-full border-2 border-current in-data-[state=open]:bg-current in-data-[state=open]:ring-4 in-data-[state=open]:ring-current/20"
	></span>
	<span data-open-label>Mon–Sat · 10 AM–6 PM</span>
</p>

<script>
	import { getOpenStatus } from '../lib/open-status'

	const sync = () => {
		const status = getOpenStatus(new Date())

		for (const root of document.querySelectorAll<HTMLElement>(
			'[data-open-status]',
		)) {
			root.dataset.state = status.open ? 'open' : 'closed'
			const label = root.querySelector('[data-open-label]')

			if (label) label.textContent = status.label
		}
	}

	sync()

	setInterval(sync, 60_000)
</script>
