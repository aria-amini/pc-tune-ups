---
import { services } from '../lib/services'
import ServiceIcon from './service-icon.astro'
---

<section id="services" class="mx-auto max-w-7xl px-5 py-14 sm:px-8 lg:py-20">
	<div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-2">
		<h2 class="font-display text-5xl text-ink sm:text-6xl">What we fix</h2>
		<p class="text-lg text-muted-foreground">
			Not sure it is fixable? Bring it by.
		</p>
	</div>
	<ul class="mt-8 grid gap-x-12 border-t border-ink/15 md:grid-cols-2">
		{services.map(({ id, icon, title, description }) => (
			<li id={id} class="scroll-mt-8 border-b border-ink/15 py-5">
				<h3 class="flex items-start gap-3 text-xl font-bold text-ink">
					<ServiceIcon
						icon={icon}
						class="mt-0.5 size-6 shrink-0 text-primary-strong"
					/>
					{title}
				</h3>
				<p class="mt-1 pl-9 text-base/relaxed text-muted-foreground">
					{description}
				</p>
			</li>
		))}
	</ul>
</section>
