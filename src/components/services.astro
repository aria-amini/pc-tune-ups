	{
		title: 'Computer & laptop repair',
		description:
			'Hardware replacement, OS reinstalls, cracked screens and hinges, and full tune-ups.',
	},
	{
		title: 'Apple device repair',
		description:
			'Mac, iPhone, and iPad: battery swaps, memory upgrades, water damage, and logic-board diagnostics.',
	},
	{
		title: 'Data backup & recovery',
		description:
			'Recovery from hard drives, flash storage, and memory cards, plus backup planning.',
	},
	{
		title: 'Networking & on-site support',
		description:
			'Wi-Fi and router setup, small-business networks, and maintenance visits at your office or home.',
	},
	{
		title: 'Virus & spyware removal',
		description: 'Malware cleanup, security audits, and prevention.',
	},
	{
		title: 'Hardware upgrades',
		description:
			'RAM, SSD, GPU, and other upgrades that extend the life of the machine you own.',
	},
	{
		title: 'Custom-built computers',
		description:
			'Gaming rigs, creative workstations, and business desktops built to your specs.',
	},
]
---

<section
	id="services"
	class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:gap-12 lg:py-28"
>
	<div class="lg:sticky lg:top-12 lg:col-span-4 lg:self-start">
		<h2 class="font-display text-6xl text-ink sm:text-7xl">What we fix</h2>
		<p class="mt-5 max-w-sm text-lg/relaxed text-muted-foreground">
			Not sure it is fixable? Bring it by. We will look at it at the counter.
		</p>
	</div>
	<ul class="divide-y divide-ink/15 border-y border-ink/15 lg:col-span-8">
		{services.map(({ title, description }) => (
			<li class="grid gap-1 py-5 sm:grid-cols-5 sm:gap-8">
				<h3 class="text-xl font-bold text-ink sm:col-span-2">{title}</h3>
				<p class="text-base/relaxed text-muted-foreground sm:col-span-3">
					{description}
				</p>
			</li>
		))}
	</ul>
</section>
