---
interface Props {
	title: string
	description: string
}

const { title, description } = Astro.props
---

<article class="relative overflow-hidden rounded-2xl border border-border bg-card p-6 shadow-sm">
	<div class="absolute top-0 right-0 h-32 w-32 rounded-full bg-primary-muted/40 blur-3xl"></div>
	<div class="relative space-y-3">
		<div class="flex items-start justify-between gap-4">
			<h3 class="text-2xl font-semibold text-foreground">{title}</h3>
			<slot />
		</div>
		<p class="text-base leading-relaxed text-muted-foreground sm:text-lg">
			{description}
		</p>
	</div>
</article>
