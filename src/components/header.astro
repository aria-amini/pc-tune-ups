---
import Icon from './icon.astro'

const phone = '504-885-1635'

const href = `tel:1${phone.replaceAll('-', '')}`

const mapLink = 'https://maps.app.goo.gl/HFwuccUoHaHKUXVG9'

const location = '3943 Veterans Blvd, Metairie, LA'
---

<header class="top-0 z-50 min-w-fit border-b border-border bg-card/95 text-nowrap shadow-md backdrop-blur-xl supports-backdrop-filter:bg-card/90 md:sticky">
	<div class="mx-auto flex max-w-5xl flex-nowrap justify-between gap-4 p-4 text-muted-foreground max-md:flex-col max-md:items-start md:gap-6 md:px-8 md:py-6">
		<div class="space-y-1.5 max-md:w-full max-md:border-t max-md:border-border max-md:pt-4 max-md:first:border-t-0 max-md:first:pt-0">
			<a
				class="group flex items-center gap-1.5 font-semibold text-foreground transition-colors duration-200 hover:text-primary-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-hover"
				href={href}
			>
				<Icon
					name="Phone"
					class="inline-block h-5 w-5 text-primary-hover transition-transform duration-200 group-hover:scale-110 md:h-6 md:w-6"
				/>
				<span>{phone}</span>
			</a>
		</div>
		<div class="space-y-1.5 max-md:w-full max-md:border-t max-md:border-border max-md:pt-4">
			<a
				class="group flex items-center gap-1.5 font-medium text-foreground/85 transition-colors duration-200 hover:text-primary-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-hover"
				href={mapLink}
				target="_blank"
				rel="noreferrer"
			>
				<Icon
					name="MapPin"
					class="inline-block h-5 w-5 text-primary-hover transition-transform duration-200 group-hover:scale-110 md:h-6 md:w-6"
				/>
				<span>{location}</span>
			</a>
		</div>
		<div class="space-y-1.5 max-md:w-full max-md:border-t max-md:border-border max-md:pt-4">
			<p class="flex items-center gap-1.5 font-medium text-foreground/85">
				<Icon name="Clock" class="h-5 w-5 text-primary-hover md:h-6 md:w-6" />
				<span>Mon-Sat, 10AM-6PM</span>
			</p>
		</div>
	</div>
</header>
