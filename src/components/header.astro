---
import { shop } from '../lib/shop'
import Icon from './icon.astro'
---

<header class="bg-primary text-ink">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8 sm:py-5">
		<a
			href="/"
			aria-label="PC Tune-Ups home"
			class="rounded-xl bg-white px-3 py-1.5 shadow-md shadow-ink/20"
		>
			<img
				src="/logo.png"
				alt="PC Tune-Ups"
				width="329"
				height="130"
				class="h-10 w-auto sm:h-11"
				decoding="async"
			/>
		</a>
		<a
			href={shop.phoneHref}
			class="-mr-3 inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-md px-3 text-sm font-semibold underline-offset-4 hover:underline"
		>
			<Icon name="Phone" class="size-4" />
			<span class="max-sm:sr-only">{shop.phone}</span>
		</a>
	</div>
</header>
