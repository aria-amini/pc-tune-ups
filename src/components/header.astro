---
import { shop } from '../lib/shop'
import Icon from './icon.astro'
---

<header class="border-b border-border">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4 sm:px-10">
		<a
			href="/"
			class="flex items-center gap-3 font-display text-xl font-bold tracking-tight"
		>
			<img
				src="/icon.png"
				alt=""
				width="36"
				height="36"
				class="size-9 rounded-lg"
			/>
			{shop.name}
		</a>
		<a
			href={shop.phoneHref}
			class="inline-flex items-center gap-2 font-semibold tabular-nums hover:text-accent"
		>
			<Icon name="Phone" class="size-5 text-accent" />
			<span class="sm:hidden">Call</span>
			<span class="max-sm:hidden">{shop.phone}</span>
		</a>
	</div>
</header>
