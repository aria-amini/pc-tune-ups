---
import { socialIcons } from '../lib/social-icons'
import { socialLinks } from '../lib/shop'
import Icon from './icon.astro'

const currentYear = new Date().getFullYear()
---

<footer class="bg-ink text-ink-foreground max-md:pb-20">
	<div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-10 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-8">
		<p class="text-ink-foreground/70">
			<span class="font-bold text-ink-foreground">PC Tune-Ups</span> · ©{' '}
			{currentYear}. All rights reserved.
		</p>
		<ul class="flex flex-wrap items-center gap-2">
			{socialLinks.map(({ name, href, icon }) => (
				<li>
					<a
						class="on-ink-focus inline-flex size-11 items-center justify-center rounded-lg text-ink-foreground/80 transition-colors duration-200 hover:bg-ink-foreground/10 hover:text-primary"
						href={href}
						target="_blank"
						rel="noreferrer"
						aria-label={name}
					>
						<Icon node={socialIcons[icon]} class="size-5" />
					</a>
				</li>
			))}
		</ul>
	</div>
</footer>
