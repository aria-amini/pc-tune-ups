---
import { address, shop } from '../lib/shop'
import Icon from './icon.astro'
import OpenStatus from './open-status.astro'

const fixes = [
	'Laptops',
	'Desktops',
	'iPhone & iPad',
	'Mac',
	'Data recovery',
	'Networking',
	'Virus removal',
	'Custom builds',
]
---

<section class="bg-primary text-ink">
	<div class="mx-auto grid max-w-7xl gap-x-12 gap-y-8 px-5 pt-4 sm:px-8 lg:grid-cols-12 lg:pt-8">
		<div class="flex flex-col justify-center lg:col-span-7 lg:pb-16">
			<h1 class="animate-rise font-display text-hero">
				Broken device?
				<br />
				Walk in.
			</h1>
			<p class="mt-6 max-w-xl animate-rise text-lg/relaxed font-medium text-ink/80 rise-delay-1 sm:text-xl/relaxed">
				Repairs, upgrades, data recovery, and custom builds for computers, Macs,
				iPhones, and iPads. A neighborhood repair counter on Veterans Blvd for
				10 years.
			</p>
			<div class="mt-8 flex animate-rise flex-wrap items-center gap-x-8 gap-y-4 rise-delay-2">
				<a
					data-hero-cta
					href={shop.mapLink}
					target="_blank"
					rel="noreferrer"
					class="group inline-flex h-14 items-center gap-2.5 rounded-xl bg-ink px-7 text-lg font-bold text-primary shadow-lg shadow-ink/25 transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-xl hover:shadow-ink/30 active:translate-y-0 active:shadow-md focus-visible:outline-ink"
				>
					Get directions
					<Icon
						name="ArrowUpRight"
						class="size-5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
					/>
				</a>
				<a
					href={shop.phoneHref}
					class="rounded-md text-base font-semibold underline decoration-2 underline-offset-4 hover:decoration-ink/50"
				>
					or call {shop.phone}
				</a>
			</div>
			<div class="mt-6 flex animate-rise flex-wrap items-center gap-x-5 gap-y-3 rise-delay-3">
				<OpenStatus />
				<p class="flex items-center gap-2 text-sm font-semibold">
					<Icon name="MapPin" class="size-4 shrink-0" />
					<span>{address}</span>
				</p>
			</div>
		</div>

		<div class="relative min-h-72 animate-rise overflow-hidden rounded-t-3xl bg-ink rise-delay-2 lg:col-span-5 lg:self-end">
			<img
				src="/photos/pc1.webp"
				alt="The PC Tune-Ups storefront on Veterans Blvd, with the green sign above the door"
				width="1360"
				height="1020"
				class="absolute inset-0 size-full object-cover object-[56%_50%]"
				fetchpriority="high"
			/>
			<div class="aspect-16/10 lg:aspect-4/5"></div>
		</div>
	</div>

	<div class="bg-ink text-primary">
		<ul class="mx-auto flex max-w-7xl flex-wrap justify-center gap-x-9 gap-y-1 px-5 py-4 font-display text-xl sm:px-8 lg:justify-between">
			{fixes.map((fix) => (
				<li>{fix}</li>
			))}
		</ul>
	</div>
</section>
