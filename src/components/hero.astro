---
import { address, directionsLink, hours, mapEmbed, shop } from '../lib/shop'
import Icon from './icon.astro'
import ServiceIcon from './service-icon.astro'
import { services } from '../lib/services'
---

<section class="bg-primary text-ink">
	<div class="mx-auto grid max-w-7xl gap-x-12 gap-y-8 px-5 pt-4 sm:px-8 lg:grid-cols-12 lg:pt-8">
		<div class="flex flex-col justify-center lg:col-span-7 lg:pb-16">
			<h1 class="animate-rise font-display text-hero">
				Broken device?
				<br />
				Walk in.
			</h1>
			<p class="mt-6 max-w-xl animate-rise text-lg/relaxed font-medium text-ink/80 rise-delay-1 sm:text-xl/relaxed">
				Repairs, upgrades, data recovery, and custom builds for computers, Macs,
				iPhones, and iPads. A neighborhood repair counter on Veterans Blvd for
				10 years.
			</p>
			<div class="mt-8 flex animate-rise flex-wrap items-center gap-x-8 gap-y-4 rise-delay-2">
				<a
					data-hero-cta
					href={directionsLink}
					target="_blank"
					rel="noreferrer"
					class="group inline-flex h-16 items-center gap-5 rounded-xl bg-ink pr-6 pl-7 text-primary shadow-lg shadow-ink/25 transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-xl hover:shadow-ink/30 focus-visible:outline-ink active:translate-y-0 active:shadow-md"
				>
					<span class="text-left">
						<span class="block text-lg/tight font-bold">Get directions</span>
						<span class="block text-sm/tight font-medium text-primary/75">
							{shop.street}, {shop.city}
						</span>
					</span>
					<Icon
						name="ArrowUpRight"
						class="size-6 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
					/>
				</a>
				<dl class="space-y-0.5 text-sm">
					{hours.map(({ days, time }) => (
						<div class="flex gap-3">
							<dt class="w-16 font-semibold">{days}</dt>
							<dd class="text-ink/80">{time}</dd>
						</div>
					))}
				</dl>
			</div>
		</div>

		<div class="mt-6 mb-12 flex animate-rise flex-col overflow-hidden rounded-3xl border-2 border-ink bg-ink shadow-xl shadow-ink/25 rise-delay-2 lg:col-span-5 lg:mt-0 lg:mb-16 lg:self-stretch">
			<div class="relative h-72 bg-primary-soft lg:h-auto lg:min-h-80 lg:flex-1">
				<iframe
					title={`Map of ${shop.name} at ${address}`}
					src={mapEmbed}
					class="absolute inset-0 size-full border-0 max-lg:pointer-events-none"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
				<a
					href={directionsLink}
					target="_blank"
					rel="noreferrer"
					aria-label={`Open directions to ${address}`}
					class="absolute inset-0 lg:hidden"
				></a>
			</div>
			<div class="flex items-center gap-4 p-3 text-ink-foreground">
				<div class="aspect-4/3 w-24 shrink-0 overflow-hidden rounded-lg">
					<img
						src="/photos/pc1.webp"
						alt="The PC Tune-Ups storefront, with the green sign above the door"
						width="1360"
						height="1020"
						class="size-full origin-center scale-150 object-cover"
					/>
				</div>
				<div class="space-y-1">
					<p class="flex items-center gap-1.5 text-sm font-bold text-primary">
						<Icon name="Lightbulb" class="size-4 shrink-0" />
						Tip
					</p>
					<p class="text-base/snug font-medium">
						Look for the green sign above the door.
					</p>
				</div>
			</div>
		</div>
	</div>

	<div class="bg-ink text-primary">
		<nav aria-label="Services" class="mx-auto max-w-7xl px-5 py-5 sm:px-8">
			<ul class="grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3 lg:grid-cols-4">
				{services.map(({ id, icon, title }) => (
					<li>
						<a
							href={`#${id}`}
							class="on-ink-focus flex items-start gap-2.5 rounded-sm py-1 font-display text-lg leading-snug underline-offset-4 hover:underline"
						>
							<ServiceIcon icon={icon} class="mt-0.5 size-5 shrink-0" />
							<span>{title}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</section>
