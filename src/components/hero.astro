---
import { shop } from '../lib/shop'
import Icon from './icon.astro'
import OpenStatus from './open-status.astro'
---

<section class="mx-auto grid max-w-6xl gap-10 px-6 py-10 sm:px-10 lg:grid-cols-12 lg:gap-14 lg:py-16">
	<div class="space-y-8 lg:col-span-7 lg:py-6">
		<div class="space-y-5">
			<h1 class="text-4xl leading-none font-bold tracking-tight sm:text-5xl lg:text-6xl">
				Walk-in computer and device repair in Metairie.
			</h1>
			<p class="max-w-xl text-lg text-muted-foreground sm:text-xl">
				We fix laptops, desktops, iPhones, iPads, and tablets. We also do data
				recovery, networking, custom builds, and Control4 home automation.
			</p>
		</div>

		<div class="flex flex-wrap gap-3">
			<a
				href={shop.mapUrl}
				target="_blank"
				rel="noreferrer"
				class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3.5 text-lg font-semibold text-primary-foreground transition-colors duration-200 hover:bg-secondary hover:text-secondary-foreground"
			>
				<Icon name="MapPin" class="size-5" />
				Get directions
			</a>
			<a
				href={shop.phoneHref}
				class="inline-flex items-center gap-2 rounded-lg border border-foreground/30 px-6 py-3.5 text-lg font-semibold tabular-nums transition-colors duration-200 hover:bg-muted"
			>
				<Icon name="Phone" class="size-5" />
				{shop.phone}
			</a>
		</div>

		<p class="text-muted-foreground">
			{shop.street}, {shop.city}, {shop.region}. In business for 10 years.
		</p>
	</div>

	<div class="lg:col-span-5">
		<img
			src="/photos/pc1.webp"
			alt="The PC Tune-Ups storefront on Veterans Blvd, under the green PC Tune-Ups sign."
			width="1359"
			height="1019"
			class="reveal-photo aspect-4/3 w-full rounded-xl object-cover"
		/>
		<div class="relative mt-4 lg:-mt-14 lg:ml-10">
			<OpenStatus />
		</div>
	</div>
</section>
